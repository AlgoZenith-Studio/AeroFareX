# aerofarex-core settings (read by server/core/config.py). Copy to .env.local for local
# overrides; on Railway set these as service variables. Never commit real secrets.

ENV=development                      # development | test | production

# Database (decision D1). Local default: <repo>/data/aerofarex.db
# Railway: sqlite:////data/aerofarex.db   (volume mounted at /data)
DATABASE_URL=
# Raw payload archive. Local default: file:///<repo>/data/raw
# Production: gs://aerofarex-raw-observations  (needs GOOGLE_APPLICATION_CREDENTIALS)
RAW_ARCHIVE_URL=

# Firebase: ID-token verification needs only the project id.
FIREBASE_PROJECT_ID=aerofarex
# Service-account key for Storage/Firestore writes; a path, never committed.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/aerofarex-adminsdk.json

# Local preview only: requests with no token act as this role (ANALYST | ADMIN).
# Pairs with NEXT_PUBLIC_AUTH_DEV_ROLE in the dashboard. Refused when ENV=production.
AUTH_DEV_ROLE=

# API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_RATE_LIMIT_PER_MINUTE=60
PUBLIC_CACHE_TTL_SECONDS=300

# Methodology (TRD Part B). BASE_DATE must be a day on which every route × window
# was collected; 2026-09-01 matches the demo seed.
BASE_DATE=2026-09-01
METHODOLOGY_VERSION=h-1.2
OUTLIER_IQR_MULTIPLIER=1.5
ATTRIBUTION_RECONCILIATION_TOLERANCE=0.0001

# Scheduler (decision D2): collection slots and publication time, IST.
SCHEDULER_ENABLED=false
COLLECTION_SLOTS=02:30,05:30,13:00,19:00
PUBLICATION_TIME=20:00
