# AeroFareX frontend environment configuration

# API
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCK=true

# Firebase (client SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local preview only (`next dev`): sign in as this role without Firebase.
# VIEWER | ANALYST | ADMIN. Ignored in production builds. Leave empty to use Firebase.
NEXT_PUBLIC_AUTH_DEV_ROLE=

# Public landing site (for the "Back to website" link on the login page)
NEXT_PUBLIC_LANDING_URL=http://localhost:5173
