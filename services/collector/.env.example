# AeroFareX collector settings (read by collector/config.py; the database and raw
# archive come from dashboard/backend settings: DATABASE_URL, RAW_ARCHIVE_URL).

# Sources to collect (comma-separated). A source runs only once its adapter is
# configured (collector/adapters/sources.py) and permission is confirmed.
ENABLED_SOURCES=

# Declared collector identity and etiquette. Do not weaken these.
USER_AGENT=AeroFareX-StatisticalCollector/2.0 (+https://mospi.gov.in/aerofarex-collector)
RATE_LIMIT_SECONDS=3.5
MAX_RETRIES=4
DOWNLOAD_TIMEOUT_SECONDS=30
OBEY_ROBOTS_TXT=true

# Circuit breaker
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_DEGRADED_BELOW=0.8
CIRCUIT_COOLDOWN_HOURS=24

# Screening
OUTLIER_IQR_MULTIPLIER=1.5
PHANTOM_MIN_SEATS=2

# Firebase Storage archive + Firestore health (production): set RAW_ARCHIVE_URL=gs://<bucket>
# and GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json (never commit the key).
