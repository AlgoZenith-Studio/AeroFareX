# AirFare API environment configuration

# Database
DATABASE_URL=postgresql+asyncpg://airfare:<pw>@localhost:5432/airfare
DB_POOL_MIN=2
DB_POOL_MAX=10

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120

# Statistics / methodology
BASE_PERIOD_START=2026-09-01
BASE_PERIOD_END=2026-09-30
METHODOLOGY_VERSION=2.0.1
OUTLIER_IQR_MULTIPLIER=1.5
SURGE_MAD_MULTIPLIER=3.5
CARRY_FORWARD_MAX_DAYS=3
ATTRIBUTION_RECONCILIATION_TOLERANCE=0.0001
CHAIN_DRIFT_MAX=0.15
